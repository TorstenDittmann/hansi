# Public base URL of this instance. GitHub sends webhooks here, so it must be reachable from
# the internet (use a tunnel such as `cloudflared tunnel --url http://localhost:5173` locally).
APP_URL=http://localhost:5173

# libSQL: a local file, or `libsql://…` / `http://…` for sqld or Turso.
DATABASE_URL=file:./data/hans.db
# DATABASE_AUTH_TOKEN=

# Generate both with: openssl rand -base64 32
HANS_ENCRYPTION_KEY=
BETTER_AUTH_SECRET=

# Optional. The /setup page creates a GitHub App and stores its credentials encrypted in the
# database. Set these instead to manage the app yourself; they take precedence.
# GITHUB_APP_ID=
# GITHUB_APP_SLUG=
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n…"
# GITHUB_WEBHOOK_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# LOG_LEVEL=info
# WORKER_CONCURRENCY=2
# WORKER_WORKDIR=/tmp/hans
