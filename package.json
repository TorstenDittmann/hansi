{
	"name": "hans",
	"private": true,
	"type": "module",
	"license": "MIT",
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"@libsql/client": "^0.18.0",
			"@types/bun": "^1.4.2",
			"ai": "^7.0.112",
			"drizzle-orm": "^0.45.3",
			"octokit": "^5.0.5",
			"typescript": "^6.0.3",
			"yaml": "^2.9.1",
			"zod": "^4.6.5"
		}
	},
	"scripts": {
		"dev": "bun run db:migrate && wsu dev",
		"build": "wsu build",
		"check": "wsu run check",
		"test": "wsu run test",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"db:generate": "bun run --cwd packages/db generate",
		"db:migrate": "bun run --cwd packages/db migrate"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/bun": "catalog:",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"typescript": "catalog:",
		"typescript-eslint": "^8.60.1",
		"workspace-utils": "^2.1.2"
	},
	"dependencies": {
		"@hans/db": "workspace:*"
	}
}
